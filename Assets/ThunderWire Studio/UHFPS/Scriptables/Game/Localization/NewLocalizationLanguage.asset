    Key: item.description.camcorder
    Value: "\u041E\u0441\u0432\u0435\u0442\u0438\u0442\u0435 \u0442\u044C\u043C\u0443.
      \u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0438
      \u043D\u043E\u0447\u043D\u043E\u0433\u043E \u0432\u0438\u0434\u0435\u043D\u0438\u044F
      \u044D\u0442\u0430 \u043A\u0430\u043C\u0435\u0440\u0430 \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u043E
      \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u0434\u043B\u044F \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u044F
      \u0438 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F
