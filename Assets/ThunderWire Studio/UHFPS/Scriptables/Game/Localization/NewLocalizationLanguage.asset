    Key: item.description.flashlight
    Value: "\u041C\u043E\u0449\u043D\u044B\u0439 \u043B\u0443\u0447 \u0441\u0432\u0435\u0442\u0430
      \u0432 \u043F\u0440\u043E\u0447\u043D\u043E\u043C \u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u043E\u043C
      \u043A\u043E\u0440\u043F\u0443\u0441\u0435. \u0418\u0434\u0435\u0430\u043B\u044C\u043D\u043E
      \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u0434\u043B\u044F \u043E\u0441\u0432\u0435\u0449\u0435\u043D\u0438\u044F
      \u0442\u0451\u043C\u043D\u044B\u0445 \u043C\u0435\u0441\u0442 \u0438 \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u0438\u044F
      \u0441\u043A\u0440\u044B\u0442\u044B\u0445 \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0435\u0439."
