  - EntryId: 63376783
    SectionId: 14790497
    Key: papers.example
    Value: "\u042D\u0442\u043E \u043F\u0440\u0438\u043C\u0435\u0440 \u0442\u0435\u043A\u0441\u0442\u0430
      \u043D\u0430 \u0431\u0443\u043C\u0430\u0433\u0435 \u0434\u043B\u044F \u0434\u0435\u043C\u043E\u043D\u0441\u0442\u0440\u0430\u0446\u0438\u0438
      \u0441\u0438\u0441\u0442\u0435\u043C\u044B \u043E\u0441\u043C\u043E\u0442\u0440\u0430.
      \u0412\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u043E\u0442\u043E\u0431\u0440\u0430\u0437\u0438\u0442\u044C
      \u0442\u0435\u043A\u0441\u0442 \u043D\u0430 \u0431\u0443\u043C\u0430\u0433\u0435
      \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u0442\u0435\u043A\u0441\u0442\u0443\u0440\u044B
      \u0438\u043B\u0438 \u043F\u0435\u0440\u0435\u043F\u0438\u0441\u0430\u0442\u044C
      \u0435\u0433\u043E \u043A\u0430\u043A \u0442\u0435\u043A\u0441\u0442 \u0434\u043B\u044F
      \u043E\u0441\u043C\u043E\u0442\u0440\u0430.\r\n\r\n- \u041E\u0442 \u041F\u0430\u0442\u0440\u0438\u043A\u0430"
  - EntryId: 24767859
    SectionId: 14790497
    Key: papers.crafting.ammo
    Value: "\u041F\u0410\u0422\u0420\u041E\u041D\u042B 9MM\r\n\u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u043E
      \u043F\u043E \u043A\u0440\u0430\u0444\u0442\u0443\r\n\r\n\u0420\u0435\u0446\u0435\u043F\u0442
      \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u044F 10 \u043F\u0430\u0442\u0440\u043E\u043D\u043E\u0432
      9mm. \u0414\u043B\u044F \u0438\u0437\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u044F
      \u043E\u0434\u043D\u043E\u0433\u043E \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u043D\u043E\u0433\u043E
      \u043F\u0430\u0442\u0440\u043E\u043D\u0430 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
      \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u0438\u0442\u044C \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0435
