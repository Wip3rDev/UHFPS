  - EntryId: 75562718
    SectionId: 22328812
    Key: loading.description.demoscene
    Value: "\u0412 \u044D\u0442\u043E\u0439 \u0434\u0435\u043C\u043E\u043D\u0441\u0442\u0440\u0430\u0446\u0438\u043E\u043D\u043D\u043E\u0439
      \u0441\u0446\u0435\u043D\u0435 \u0432\u044B \u0441\u043C\u043E\u0436\u0435\u0442\u0435
      \u0443\u0432\u0438\u0434\u0435\u0442\u044C \u0438 \u0438\u0437\u0443\u0447\u0438\u0442\u044C
      \u0432\u0441\u0435 \u0432\u043F\u0435\u0447\u0430\u0442\u043B\u044F\u044E\u0449\u0438\u0435
      \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0438 \u043D\u0430\u0431\u043E\u0440\u0430.
      \u0421\u0446\u0435\u043D\u0430 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E
      \u0441\u043E\u0437\u0434\u0430\u043D\u0430, \u0447\u0442\u043E\u0431\u044B
      \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C \u0432\u0435\u0441\u044C \u043F\u043E\u0442\u0435\u043D\u0446\u0438\u0430\u043B
      \u0430\u0441\u0441\u0435\u0442\u0430, \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044F
      \u0432\u0441\u0435\u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0435 \u0435\u0433\u043E
      \u043F\u0440\u043E\u0442\u0435\u0441\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C."
  - EntryId: 48298615
    SectionId: 22328812
    Key: loading.description.demoscene2
    Value: "\u0412 \u044D\u0442\u043E\u0439 \u0438\u043D\u0442\u0435\u0440\u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0439
      \u0434\u0435\u043C\u043E-\u0441\u0446\u0435\u043D\u0435 \u0443 \u0432\u0430\u0441
      \u0431\u0443\u0434\u0435\u0442 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C
      \u043B\u0438\u0447\u043D\u043E \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
      \u0441 \u043B\u0438\u0444\u0442\u043E\u0432\u043E\u0439 \u0441\u0438\u0441\u0442\u0435\u043C\u043E\u0439,
      \u0434\u0435\u043C\u043E\u043D\u0441\u0442\u0440\u0438\u0440\u0443\u044F \u0435\u0451
      \u043F\u043B\u0430\u0432\u043D\u0443\u044E \u0440\u0430\u0431\u043E\u0442\u0443
      \u0438 \u0438\u043D\u0442\u0435\u0433\u0440\u0430\u0446\u0438\u044E, \u0430
      \u0442\u0430\u043A\u0436\u0435 \u0434\u0440\u0443\u0433\u0438\u0435 \u0437\u0430\u043C\u0435\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0435
      \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0441\u0442\u0438 \u043D\u0430\u0431\u043E\u0440\u0430."
  - EntryId: 99899103
    SectionId: 22328812
    Key: loading.description.demoscene3
    Value: "\u041D\u0430 \u0443\u043B\u0438\u0446\u0435 \u0438\u0434\u0451\u0442
      \u0434\u043E\u0436\u0434\u044C. \u0412\u044B \u043C\u043E\u0436\u0435\u0442\u0435
      \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C, \u043A\u0430\u043A
      \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442 \u044D\u0444\u0444\u0435\u043A\u0442
      \u043A\u0430\u043F\u0435\u043B\u044C, \u043A\u043E\u0433\u0434\u0430 \u0432\u044B
      \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0435\u0441\u044C \u043F\u043E\u0434
      \u043A\u0440\u044B\u0448\u0435\u0439 \u0438\u043B\u0438 \u043D\u0435\u0442."
  - EntryId: 60467349
    SectionId: 22328812
    Key: loading.park
    Value: "\u0422\u0440\u0435\u0439\u043B\u0435\u0440\u043D\u044B\u0439 \u043F\u0430\u0440\u043A"
